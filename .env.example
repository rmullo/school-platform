# pnpm setup generates .env with local random passwords. Never use real school data.
POSTGRES_USER=smartschool
POSTGRES_PASSWORD=generated-by-setup
POSTGRES_DB=smartschool
DATABASE_URL=postgresql://smartschool:generated-by-setup@localhost:55432/smartschool
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=smartschool-local
S3_ACCESS_KEY=smartschool-local
S3_SECRET_KEY=generated-by-setup
API_PORT=3333
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

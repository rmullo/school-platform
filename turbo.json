{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@smartschool/database#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "src/generated/**"
      ]
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "S3_*",
    "API_PORT",
    "WEB_ORIGIN",
    "LOG_LEVEL",
    "API_PROXY_TARGET"
  ]
}

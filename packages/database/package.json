    "migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.23.1",
    "dotenv": "18.0.7"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "@types/pg": "8.23.1"
  }
}

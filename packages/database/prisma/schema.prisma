generator client {
  provider = "prisma-client"
  output = "../src/generated"
  moduleFormat = "esm"
}
datasource db {
  provider = "postgresql"
}
// Technical fixture only. No school or financial domain is implemented in MD-01.
model FoundationState {
  key       String   @id
  token     String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

enum Role {
  DIRECTOR
  SECRETARY
  IT
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String
  email String @unique
  passwordHash String
  role Role
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  sessions Session[]
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id])
  refreshHash String @unique
  familyId String @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([userId])
  @@index([familyId])
}

model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  action String
  targetId String @db.Uuid
  reason String
  changes Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([createdAt, id])
}

model SchoolYear {
  id String @id @default(uuid()) @db.Uuid
  year Int @unique
  startDate String @db.VarChar(10)
  endDate String @db.VarChar(10)
  version Int @default(1)
  classrooms Classroom[]
  campaigns Campaign[]
  transitions EnrollmentTransition[]
  materialKits MaterialKit[]
}

enum SchoolSegment {
  INFANTIL
  FUNDAMENTAL
}

model SchoolStage {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  segment SchoolSegment
  authorization Json?
  version Int @default(1)
  grades SchoolGrade[]
  documentRequirements DocumentRequirement[]
}

model SchoolGrade {
  id String @id @default(uuid()) @db.Uuid
  name String
  stageId String @db.Uuid
  stage SchoolStage @relation(fields: [stageId], references: [id])
  version Int @default(1)
  classrooms Classroom[]
  materialKits MaterialKit[]
  @@unique([stageId, name])
}

model Classroom {
  id String @id @default(uuid()) @db.Uuid
  name String
  schoolYearId String @db.Uuid
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])
  gradeId String @db.Uuid
  grade SchoolGrade @relation(fields: [gradeId], references: [id])
  capacity Int
  occupied Int @default(0)
  active Boolean @default(false)
  version Int @default(1)
  campaignOffers CampaignOffer[]
  enrollmentDrafts EnrollmentDraft[]
  enrollments Enrollment[]
  @@unique([schoolYearId, gradeId, name])
}

enum ParentageRole {
  MOTHER
  FATHER
  OTHER
}

enum RepresentationKind {
  LEGAL_GUARDIAN
  LEGAL_REPRESENTATIVE
}

model Person {
  id                 String                       @id @default(uuid()) @db.Uuid
  name               String
  email              String?
  phone              String?
  birthDate          String?                      @db.VarChar(10)
  version            Int                          @default(1)
  createdAt          DateTime                     @default(now()) @db.Timestamptz(3)
  student            StudentProfile?
  parentageFor       StudentParentage[]           @relation("ParentagePerson")
  representationsFor StudentRepresentation[]     @relation("RepresentationPerson")
  financialFor       StudentFinancialResponsible[] @relation("FinancialPerson")
  enrollmentFinancialResponsibleFor EnrollmentDraft[] @relation("EnrollmentFinancialResponsible")
  enrollmentFinancialResponsibleForConfirmed Enrollment[] @relation("EnrollmentConfirmedFinancialResponsible")
  pickupFor          PickupAuthorization[]       @relation("PickupPerson")
  @@index([name])
}

model StudentProfile {
  id             String                        @id @default(uuid()) @db.Uuid
  personId       String                        @unique @db.Uuid
  person         Person                        @relation(fields: [personId], references: [id])
  active         Boolean                       @default(true)
  version        Int                           @default(1)
  parentage      StudentParentage[]            @relation("ParentageStudent")
  representations StudentRepresentation[]      @relation("RepresentationStudent")
  financial      StudentFinancialResponsible?  @relation("FinancialStudent")
  pickup         PickupAuthorization[]         @relation("PickupStudent")
  enrollmentDrafts EnrollmentDraft[]
  enrollments Enrollment[]
  documents StudentDocument[]
  transitions EnrollmentTransition[]
  materialOrders MaterialOrder[]
}

model StudentParentage {
  id         String       @id @default(uuid()) @db.Uuid
  studentId  String       @db.Uuid
  student    StudentProfile @relation("ParentageStudent", fields: [studentId], references: [id])
  personId   String       @db.Uuid
  person     Person       @relation("ParentagePerson", fields: [personId], references: [id])
  role       ParentageRole
  evidence   String
  validFrom  String       @db.VarChar(10)
  validUntil String       @db.VarChar(10)
  version    Int          @default(1)
  @@unique([studentId, personId, role])
  @@index([personId])
}

model StudentRepresentation {
  id           String             @id @default(uuid()) @db.Uuid
  studentId    String             @db.Uuid
  student      StudentProfile     @relation("RepresentationStudent", fields: [studentId], references: [id])
  personId     String             @db.Uuid
  person       Person             @relation("RepresentationPerson", fields: [personId], references: [id])
  kind         RepresentationKind
  evidence     String
  restrictions String?
  validFrom    String             @db.VarChar(10)
  validUntil   String             @db.VarChar(10)
  version      Int                @default(1)
  @@unique([studentId, personId, kind])
  @@index([personId])
}

model StudentFinancialResponsible {
  id        String         @id @default(uuid()) @db.Uuid
  studentId String         @unique @db.Uuid
  student   StudentProfile @relation("FinancialStudent", fields: [studentId], references: [id])
  personId  String         @db.Uuid
  person    Person         @relation("FinancialPerson", fields: [personId], references: [id])
  evidence  String
  version   Int            @default(1)
  @@index([personId])
}

model PickupAuthorization {
  id           String         @id @default(uuid()) @db.Uuid
  studentId    String         @db.Uuid
  student      StudentProfile @relation("PickupStudent", fields: [studentId], references: [id])
  personId     String         @db.Uuid
  person       Person         @relation("PickupPerson", fields: [personId], references: [id])
  evidence     String
  restrictions String?
  validFrom    String         @db.VarChar(10)
  validUntil   String         @db.VarChar(10)
  version      Int            @default(1)
  @@unique([studentId, personId, validFrom])
  @@index([personId])
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Campaign {
  id                String             @id @default(uuid()) @db.Uuid
  schoolYearId      String             @db.Uuid
  schoolYear        SchoolYear         @relation(fields: [schoolYearId], references: [id])
  name              String
  status            CampaignStatus     @default(DRAFT)
  enrollmentStart   String             @db.VarChar(10)
  enrollmentEnd     String             @db.VarChar(10)
  disclosure        String
  calendar          String
  vacancyPolicy     String
  version           Int                @default(1)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  contracts         ContractVersion[]
  offers            CampaignOffer[]
  enrollmentDrafts  EnrollmentDraft[]
  enrollments        Enrollment[]
  @@unique([schoolYearId, name])
  @@index([schoolYearId, status])
}

model ContractVersion {
  id                         String   @id @default(uuid()) @db.Uuid
  campaignId                 String   @db.Uuid
  campaign                   Campaign @relation(fields: [campaignId], references: [id])
  version                    Int
  title                      String
  totalAnnualCents           Int
  initialInstallmentCents    Int
  remainingInstallmentCents  Int
  remainingInstallmentCount  Int
  siblingDiscountBps         Int      @default(0)
  punctualityDiscountCents   Int      @default(0)
  materialCollectiveRequired Boolean  @default(false)
  terms                      String
  validFrom                  String   @db.VarChar(10)
  validUntil                 String   @db.VarChar(10)
  createdAt                  DateTime @default(now()) @db.Timestamptz(3)
  enrollmentDrafts           EnrollmentDraft[]
  enrollments                Enrollment[]
  @@unique([campaignId, version])
  @@index([campaignId, validFrom])
}

model CampaignOffer {
  id         String    @id @default(uuid()) @db.Uuid
  campaignId String    @db.Uuid
  campaign   Campaign  @relation(fields: [campaignId], references: [id])
  classroomId String   @db.Uuid
  classroom  Classroom @relation(fields: [classroomId], references: [id])
  version    Int       @default(1)
  @@unique([campaignId, classroomId])
  @@index([classroomId])
}

enum EnrollmentStatus {
  DRAFT
}

model EnrollmentDraft {
  id                     String           @id @default(uuid()) @db.Uuid
  studentId              String           @db.Uuid
  student                StudentProfile   @relation(fields: [studentId], references: [id])
  classroomId            String           @db.Uuid
  classroom              Classroom        @relation(fields: [classroomId], references: [id])
  campaignId             String           @db.Uuid
  campaign               Campaign         @relation(fields: [campaignId], references: [id])
  contractId             String           @db.Uuid
  contract               ContractVersion  @relation(fields: [contractId], references: [id])
  financialResponsibleId String           @db.Uuid
  financialResponsible   Person           @relation("EnrollmentFinancialResponsible", fields: [financialResponsibleId], references: [id])
  status                 EnrollmentStatus @default(DRAFT)
  initialAmountCents     Int
  lateEntryMonth         Int?
  lateEntryInstallmentCount Int?
  lateEntryTotalCents    Int?
  pendingItems           String[]         @default([])
  version                Int              @default(1)
  createdAt              DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @db.Timestamptz(3)
  enrollment             Enrollment?
  @@unique([studentId, classroomId, campaignId, contractId])
  @@index([studentId])
  @@index([classroomId])
  @@index([campaignId])
}

enum SettlementKind {
  PAYMENT
  WAIVER
  NEGOTIATION
}

enum EnrollmentConfirmationStatus {
  CONFIRMED
  CANCELLED
}

enum ObligationStatus {
  SETTLED
  PARTIAL
  OPEN
  WAIVED
  CANCELLED
}

enum PaymentStatus {
  POSTED
  REVERSED
}

enum CreditStatus {
  AVAILABLE
  CONSUMED
  REVERSED
}

enum RefundStatus {
  EXECUTED
}

enum DocumentStatus {
  UPLOADED
  VALIDATED
  EXCEPTION
}

enum TransitionKind {
  RENEWAL
  TRANSFER
}

enum TransitionStatus {
  REQUESTED
  COMPLETED
  CANCELLED
}

enum MaterialItemKind {
  BOOK
  MATERIAL
  UNIFORM
}

enum MaterialSource {
  EXTERNAL
  SCHOOL
  COURTESY
}

enum MaterialOrderStatus {
  DRAFT
  ORDERED
  CANCELLED
}

enum MaterialPaymentStatus {
  NOT_APPLICABLE
  PENDING
  PAID
}

enum MaterialDeliveryStatus {
  NOT_APPLICABLE
  PENDING
  DELIVERED
}

model Enrollment {
  id                     String                        @id @default(uuid()) @db.Uuid
  draftId                String                        @unique @db.Uuid
  draft                  EnrollmentDraft               @relation(fields: [draftId], references: [id])
  studentId              String                        @db.Uuid
  student                StudentProfile                @relation(fields: [studentId], references: [id])
  classroomId            String                        @db.Uuid
  classroom              Classroom                     @relation(fields: [classroomId], references: [id])
  campaignId             String                        @db.Uuid
  campaign               Campaign                      @relation(fields: [campaignId], references: [id])
  contractId             String                        @db.Uuid
  contract               ContractVersion               @relation(fields: [contractId], references: [id])
  financialResponsibleId String                        @db.Uuid
  financialResponsible   Person                        @relation("EnrollmentConfirmedFinancialResponsible", fields: [financialResponsibleId], references: [id])
  status                 EnrollmentConfirmationStatus  @default(CONFIRMED)
  confirmedAt            DateTime                      @default(now()) @db.Timestamptz(3)
  version                Int                           @default(1)
  settlement             InitialSettlement?
  obligations            FinancialObligation[]
  negotiations           FinancialNegotiation[]
  payments               PaymentReceipt[]
  credits                FinancialCredit[]
  cancellation           EnrollmentCancellation?
  refunds                FinancialRefund[]
  documents              StudentDocument[]
  completion             EnrollmentCompletion?
  transitionsFrom        EnrollmentTransition[] @relation("TransitionFrom")
  materialOrders         MaterialOrder[]
  @@unique([studentId, classroomId, campaignId])
  @@index([studentId])
  @@index([classroomId])
}

model InitialSettlement {
  id            String         @id @default(uuid()) @db.Uuid
  enrollmentId  String         @unique @db.Uuid
  enrollment    Enrollment     @relation(fields: [enrollmentId], references: [id])
  operationKey  String         @unique @db.Uuid
  kind          SettlementKind
  amountCents   Int
  method        String?
  reason        String
  actorId       String         @db.Uuid
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  @@index([actorId, createdAt])
}

model PaymentReceipt {
  id            String          @id @default(uuid()) @db.Uuid
  enrollmentId  String          @db.Uuid
  enrollment    Enrollment      @relation(fields: [enrollmentId], references: [id])
  operationKey  String          @unique @db.Uuid
  receiptNumber String          @unique
  amountCents   Int
  method        String
  status        PaymentStatus   @default(POSTED)
  reason        String?
  actorId       String          @db.Uuid
  receivedAt    DateTime        @default(now()) @db.Timestamptz(3)
  reversedAt    DateTime?       @db.Timestamptz(3)
  reverseReason String?
  reverseOperationKey String? @unique @db.Uuid
  allocations   PaymentAllocation[]
  credit        FinancialCredit?
  @@index([enrollmentId, receivedAt])
  @@index([actorId, receivedAt])
}

model PaymentAllocation {
  id            String             @id @default(uuid()) @db.Uuid
  paymentId     String             @db.Uuid
  payment       PaymentReceipt     @relation(fields: [paymentId], references: [id])
  obligationId  String             @db.Uuid
  obligation    FinancialObligation @relation(fields: [obligationId], references: [id])
  amountCents   Int
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  @@unique([paymentId, obligationId])
  @@index([obligationId])
}

model FinancialCredit {
  id              String             @id @default(uuid()) @db.Uuid
  enrollmentId    String             @db.Uuid
  enrollment      Enrollment         @relation(fields: [enrollmentId], references: [id])
  sourcePaymentId String             @unique @db.Uuid
  sourcePayment   PaymentReceipt    @relation(fields: [sourcePaymentId], references: [id])
  originalAmountCents Int
  balanceCents    Int
  status          CreditStatus      @default(AVAILABLE)
  allocations     CreditAllocation[]
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  @@index([enrollmentId, status])
}

model CreditAllocation {
  id            String             @id @default(uuid()) @db.Uuid
  creditId      String             @db.Uuid
  credit        FinancialCredit    @relation(fields: [creditId], references: [id])
  obligationId  String             @db.Uuid
  obligation    FinancialObligation @relation(fields: [obligationId], references: [id])
  operationKey  String             @unique @db.Uuid
  amountCents   Int
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  @@index([obligationId])
}

model FinancialObligation {
  id            String           @id @default(uuid()) @db.Uuid
  enrollmentId  String           @db.Uuid
  enrollment    Enrollment       @relation(fields: [enrollmentId], references: [id])
  installment   Int
  dueDate       String           @db.VarChar(10)
  amountCents   Int
  settledAmountCents Int            @default(0)
  status        ObligationStatus
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  @@unique([enrollmentId, installment])
  @@index([dueDate, status])
  allocations   PaymentAllocation[]
  creditAllocations CreditAllocation[]
  negotiation   FinancialNegotiation?
}

model FinancialNegotiation {
  id                    String             @id @default(uuid()) @db.Uuid
  enrollmentId          String             @db.Uuid
  enrollment             Enrollment         @relation(fields: [enrollmentId], references: [id])
  obligationId          String             @unique @db.Uuid
  obligation             FinancialObligation @relation(fields: [obligationId], references: [id])
  operationKey          String             @unique @db.Uuid
  originalAmountCents   Int
  negotiatedAmountCents Int
  originalDueDate       String             @db.VarChar(10)
  negotiatedDueDate     String             @db.VarChar(10)
  reason                String
  actorId               String             @db.Uuid
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  @@index([enrollmentId, createdAt])
  @@index([actorId, createdAt])
}

model EnrollmentCancellation {
  id                       String             @id @default(uuid()) @db.Uuid
  enrollmentId             String             @unique @db.Uuid
  enrollment               Enrollment         @relation(fields: [enrollmentId], references: [id])
  operationKey             String             @unique @db.Uuid
  effectiveDate            String             @db.VarChar(10)
  reason                   String
  actorId                  String             @db.Uuid
  refundableAmountCents    Int                @default(0)
  availableCreditCents     Int                @default(0)
  createdAt                DateTime           @default(now()) @db.Timestamptz(3)
  refund                   FinancialRefund?
  @@index([actorId, createdAt])
}

model FinancialRefund {
  id             String                @id @default(uuid()) @db.Uuid
  enrollmentId   String                @db.Uuid
  enrollment     Enrollment            @relation(fields: [enrollmentId], references: [id])
  cancellationId String                @unique @db.Uuid
  cancellation   EnrollmentCancellation @relation(fields: [cancellationId], references: [id])
  operationKey   String                @unique @db.Uuid
  amountCents    Int
  method         String
  status         RefundStatus          @default(EXECUTED)
  reason         String
  actorId        String                @db.Uuid
  executedAt     DateTime              @default(now()) @db.Timestamptz(3)
  @@index([enrollmentId, executedAt])
  @@index([actorId, executedAt])
}

model DocumentRequirement {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  stageId     String?  @db.Uuid
  stage       SchoolStage? @relation(fields: [stageId], references: [id])
  required    Boolean  @default(true)
  active      Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  documents   StudentDocument[]
  @@index([stageId, active])
}

model StudentDocument {
  id              String            @id @default(uuid()) @db.Uuid
  studentId       String            @db.Uuid
  student         StudentProfile   @relation(fields: [studentId], references: [id])
  enrollmentId    String?           @db.Uuid
  enrollment      Enrollment?       @relation(fields: [enrollmentId], references: [id])
  requirementId   String            @db.Uuid
  requirement     DocumentRequirement @relation(fields: [requirementId], references: [id])
  objectKey       String            @unique
  originalName    String
  contentType     String
  sizeBytes       Int
  status          DocumentStatus    @default(UPLOADED)
  exceptionReason String?
  uploadedBy      String            @db.Uuid
  validatedBy     String?           @db.Uuid
  validatedAt     DateTime?         @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  replacedAt      DateTime?         @db.Timestamptz(3)
  @@index([studentId, status])
  @@index([enrollmentId, requirementId])
}

model EnrollmentCompletion {
  id           String     @id @default(uuid()) @db.Uuid
  enrollmentId String     @unique @db.Uuid
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  complete     Boolean    @default(false)
  reason       String?
  actorId      String     @db.Uuid
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
}

model EnrollmentTransition {
  id                    String           @id @default(uuid()) @db.Uuid
  operationKey          String           @unique @db.Uuid
  studentId             String           @db.Uuid
  student               StudentProfile   @relation(fields: [studentId], references: [id])
  fromEnrollmentId      String?          @db.Uuid
  fromEnrollment        Enrollment?      @relation("TransitionFrom", fields: [fromEnrollmentId], references: [id])
  targetSchoolYearId    String?          @db.Uuid
  targetSchoolYear      SchoolYear?      @relation(fields: [targetSchoolYearId], references: [id])
  kind                  TransitionKind
  status                TransitionStatus @default(COMPLETED)
  destination           String?
  acknowledgementAt     DateTime?        @db.Timestamptz(3)
  documentsReleased     Boolean          @default(false)
  financialReview       String
  actorId               String           @db.Uuid
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  @@index([studentId, createdAt])
}

model MaterialKit {
  id          String        @id @default(uuid()) @db.Uuid
  schoolYearId String       @db.Uuid
  schoolYear  SchoolYear    @relation(fields: [schoolYearId], references: [id])
  gradeId     String        @db.Uuid
  grade       SchoolGrade  @relation(fields: [gradeId], references: [id])
  name        String
  active      Boolean       @default(true)
  version     Int           @default(1)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  items       MaterialItem[]
  orders      MaterialOrder[]
  @@unique([schoolYearId, gradeId, name])
}

model MaterialItem {
  id          String           @id @default(uuid()) @db.Uuid
  kitId       String           @db.Uuid
  kit         MaterialKit      @relation(fields: [kitId], references: [id])
  name        String
  kind        MaterialItemKind
  source      MaterialSource
  optional    Boolean          @default(true)
  priceCents  Int              @default(0)
  version     Int              @default(1)
  @@index([kitId, kind])
}

model MaterialOrder {
  id              String                @id @default(uuid()) @db.Uuid
  operationKey    String                @unique @db.Uuid
  studentId       String                @db.Uuid
  student         StudentProfile        @relation(fields: [studentId], references: [id])
  enrollmentId    String?               @db.Uuid
  enrollment      Enrollment?           @relation(fields: [enrollmentId], references: [id])
  kitId           String?               @db.Uuid
  kit             MaterialKit?          @relation(fields: [kitId], references: [id])
  status          MaterialOrderStatus   @default(DRAFT)
  paymentStatus   MaterialPaymentStatus @default(NOT_APPLICABLE)
  deliveryStatus  MaterialDeliveryStatus @default(NOT_APPLICABLE)
  notes           String?
  actorId         String                @db.Uuid
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  @@index([studentId, status])
}

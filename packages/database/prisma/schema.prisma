generator client {
  provider = "prisma-client"
  output = "../src/generated"
  moduleFormat = "esm"
}
datasource db {
  provider = "postgresql"
}
// Technical fixture only. No school or financial domain is implemented in MD-01.
model FoundationState {
  key       String   @id
  token     String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

enum Role {
  DIRECTOR
  SECRETARY
  IT
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String
  email String @unique
  passwordHash String
  role Role
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  sessions Session[]
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id])
  refreshHash String @unique
  familyId String @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([userId])
  @@index([familyId])
}

model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  action String
  targetId String @db.Uuid
  reason String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([createdAt, id])
}
